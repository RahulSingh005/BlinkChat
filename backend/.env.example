# ---------------------------------------------------------------------------
# BlinkChat backend configuration. Copy to backend/.env and fill in.
# Only MONGODB_URI and JWT_SECRET are required; everything else is optional
# and simply enables extra features. See README.md for step-by-step setup.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# MongoDB Atlas free cluster: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/blinkchat
MONGODB_URI=
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server -------------------------------------------------------------------
PORT=5001
NODE_ENV=development
# Only needed when the frontend is hosted on a different domain (e.g. Vercel).
# Comma-separated list of exact origins.
CLIENT_URL=
# lax (frontend + API on the same domain) | none (different domains, needs HTTPS)
# Defaults: lax in development, none in production.
COOKIE_SAMESITE=
# Set to false on large deployments to hide the "People on BlinkChat" directory.
PUBLIC_DIRECTORY=true

# --- Google sign-in (optional, free) -----------------------------------------
# OAuth Client ID (Web application) from https://console.cloud.google.com/apis/credentials
# The frontend reads it from the API at runtime; no frontend env var needed.
GOOGLE_CLIENT_ID=

# --- Media storage (optional, free) --------------------------------------------
# Without Cloudinary, uploads are saved to backend/uploads (fine for a VPS or
# local use; use Cloudinary on hosts with ephemeral disks like Render).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email for password reset codes (optional, free) ---------------------------
# Gmail: use an App Password (Google Account > Security > App passwords).
# Brevo (300 emails/day free): EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587
# In development without SMTP, codes are printed to this console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=BlinkChat <no-reply@example.com>

# --- Push notifications (optional, free) ---------------------------------------
# Generate with: npm run vapid   (paste both keys here)
# If empty, a key pair is generated automatically into backend/.data/.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI features (optional, free) ----------------------------------------------
# Easiest free option: Groq (chat + voice-note transcription), https://console.groq.com/keys
GROQ_API_KEY=
# Alternative free option: Google Gemini, https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides: groq | gemini | openrouter | anthropic | custom
AI_PROVIDER=
AI_MODEL=
# For AI_PROVIDER=custom (any OpenAI-compatible API, e.g. Ollama http://localhost:11434/v1)
AI_BASE_URL=
AI_API_KEY=
OPENROUTER_API_KEY=
# Claude (paid). Default model claude-opus-5-5; set AI_MODEL to choose another.
ANTHROPIC_API_KEY=
# Per-user daily cap so one person can't use up a shared free quota.
AI_DAILY_LIMIT_PER_USER=150

# --- Calls: TURN relay (optional, recommended for production) -----------------
# Without TURN, calls fail on many mobile/corporate networks.
# Metered (free 20 GB/month): https://www.metered.ca/tools/openrelay/
METERED_DOMAIN=
METERED_API_KEY=
# or Cloudflare Realtime TURN
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# or your own coturn server
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
