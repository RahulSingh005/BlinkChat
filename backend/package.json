{
  "name": "blinkchat-backend",
  "version": "2.0.0",
  "private": true,
  "description": "BlinkChat REST API and realtime (Socket.IO) server",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nodemon --watch src src/index.js",
    "dev:memory": "node scripts/dev-memory.js",
    "start": "node src/index.js",
    "seed": "node src/seeds/user.seed.js",
    "migrate": "node src/migrations/run.js",
    "vapid": "web-push generate-vapid-keys",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
