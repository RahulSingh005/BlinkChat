{
  "name": "BlinkChat",
  "short_name": "BlinkChat",
  "description": "Fast, thoughtful messaging with groups, calls, voice notes, smart scheduling and AI catch-up.",
  "id": "/",
  "start_url": "/chat",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f2f3f5",
  "theme_color": "#3b5bfd",
  "categories": ["social", "communication", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Chats", "url": "/chat", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reminders", "url": "/reminders", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
